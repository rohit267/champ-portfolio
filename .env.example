# Portfolio RAG chatbot provider: openai, openai-compatible, or ollama.
# RAG_PROVIDER=ollama
RAG_DEBUG=true

# OpenAI.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=nemotron-3-nano:30b-cloud
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI-compatible APIs, for example Groq/OpenRouter/LM Studio/vLLM.
# Set RAG_PROVIDER=openai-compatible and point this at the provider's /v1 base URL.
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=provider_api_key_or_not-needed
# OPENAI_MODEL=provider_chat_model
# OPENAI_EMBEDDING_MODEL=provider_embedding_model

# Ollama. Run `ollama pull llama3.1` and `ollama pull nomic-embed-text` first.
RAG_PROVIDER=ollama
OLLAMA_BASE_URL=http://51.210.15.98:11434
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Password for protected pages/routes
ADMIN_PASSWORD=password
